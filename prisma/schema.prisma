generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RagStatus {
  GREEN
  AMBER
  RED
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  ON_HOLD
  CLOSED
}

enum IssueSource {
  INTERNAL
  JIRA
}

enum IssueSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum OverviewStatus {
  DRAFT
  GENERATED
  PM_REVIEW
  APPROVED
  PUBLISHED
}

enum WbsItemType {
  PHASE
  WORK_PACKAGE
  DELIVERABLE
  MILESTONE
  GOAL
  TASK
}

enum WbsItemStatus {
  NOT_STARTED
  IN_PROGRESS
  IN_REVIEW
  AT_RISK
  BLOCKED
  DONE
  CANCELLED
}

enum RaidItemType {
  RISK
  ASSUMPTION
  DEPENDENCY
}

enum RaidItemStatus {
  OPEN
  IN_PROGRESS
  MITIGATED
  VALIDATED
  BREACHED
  CLOSED
}

enum ChangeRequestType {
  SCOPE
  BUDGET
  SCHEDULE
  RESOURCE
}

enum ChangeRequestStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  APPROVED
  REJECTED
  IMPLEMENTED
}

enum WbsDependencyType {
  FS
  SS
  FF
  SF
}

enum ProjectCalendarCode {
  RU
  CN
  RU_CN
}

enum UserRole {
  ADMIN
  PROJECT_MANAGER
  TEAM_MEMBER
  EXECUTIVE_VIEWER
}

enum WbsCommandType {
  CREATE
  UPDATE
  DELETE
  MOVE
  INDENT
  OUTDENT
  BULK_UPDATE
  RESTORE
  BASELINE
}

enum WbsBaselineStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ProjectAccessLevel {
  VIEW
  EDIT
  ADMIN
}

enum BusinessUnitRole {
  ADMIN
  PROJECT_MANAGER
  VIEWER
}

enum PageVisitActorType {
  USER
  ANONYMOUS
}

enum JiraAnalyticsScopeType {
  LABEL
  EPIC
}

enum JiraSyncRunKind {
  SYNC
  BACKFILL
  CURRENT
}

enum JiraSyncRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  SUCCEEDED_WITH_RETRIES
  PAUSED_DEADLINE
  STOPPED_CAPACITY
  FAILED
  CANCELLED
}

enum JiraIssueVersionProvenance {
  OBSERVED
  RECONSTRUCTED
}

enum JiraHistoryRetryStatus {
  PENDING
  RESOLVED
}

enum JiraAnalyticsRollbackState {
  AVAILABLE
  USED
  CLOSED
}

model BusinessUnit {
  id          String                   @id @default(cuid())
  code        String                   @unique
  name        String
  isDefault   Boolean                  @default(false)
  isActive    Boolean                  @default(true)
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  projects    Project[]
  memberships BusinessUnitMembership[]

  @@index([isActive, name])
}

model BusinessUnitMembership {
  id             String           @id @default(cuid())
  businessUnitId String
  userId         String
  role           BusinessUnitRole @default(VIEWER)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  businessUnit   BusinessUnit     @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessUnitId, userId])
  @@index([userId, role])
  @@index([businessUnitId, role])
}

model BusinessUnitRolePermission {
  id         String           @id @default(cuid())
  role       BusinessUnitRole
  permission String
  enabled    Boolean          @default(true)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([role, permission])
  @@index([role])
  @@index([permission])
}

model Project {
  id                       String                            @id @default(cuid())
  businessUnitId           String
  parentId                 String?
  code                     String                            @unique
  name                     String
  portfolio                String
  sponsor                  String
  projectManager           String
  status                   ProjectStatus                     @default(ACTIVE)
  rag                      RagStatus                         @default(GREEN)
  startDate                DateTime
  initialTargetDate        DateTime?
  targetDate               DateTime
  budgetPlanned            Decimal                           @db.Decimal(14, 2)
  budgetForecast           Decimal                           @db.Decimal(14, 2)
  scheduleVariance         Int                               @default(0)
  progress                 Int                               @default(0)
  summary                  String
  sortOrder                Int                               @default(0)
  uiState                  Json?
  createdAt                DateTime                          @default(now())
  updatedAt                DateTime                          @updatedAt
  parent                   Project?                          @relation("ProjectHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children                 Project[]                         @relation("ProjectHierarchy")
  businessUnit             BusinessUnit                      @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  jiraIntegration          JiraIntegration?
  jiraAnalyticsSettings    JiraAnalyticsSettings?
  jiraAggregateDefinitions JiraAggregateDefinition[]
  jiraAggregateRevisions   JiraAggregateDefinitionRevision[]
  jiraDashboardConversion  JiraAnalyticsDashboardConversion?
  jiraWorkSections         JiraWorkSection[]
  tasks                    Task[]
  issues                   Issue[]
  jiraSnapshots            JiraIssueSnapshot[]
  jiraIssueVersions        JiraIssueVersion[]
  jiraHistoryRetries       JiraIssueHistoryRetry[]
  jiraSyncRuns             JiraSyncRun[]
  gitlabBranchCommits      GitlabBranchCommit[]
  gitlabBranchSyncRuns     GitlabBranchSyncRun[]
  overviews                ExecutiveOverview[]
  milestones               Milestone[]
  wbsItems                 WbsItem[]
  wbsDependencies          WbsDependency[]
  calendarOverrides        ProjectCalendarOverride[]
  artifacts                ProjectArtifact[]
  raidItems                RaidItem[]
  changeRequests           ChangeRequest[]
  targetDateChanges        ProjectTargetDateChange[]
  wbsCommands              WbsCommand[]
  wbsBaselines             WbsBaseline[]
  wbsTombstones            WbsTombstone[]
  savedViews               SavedView[]
  projectAccesses          ProjectAccess[]
  artifactTable            ProjectArtifactTable?
  artifactFiles            ProjectArtifactFile[]
  businessRequirements     ProjectBusinessRequirements?

  @@index([parentId])
  @@index([businessUnitId, status])
  @@index([sortOrder])
}

model ProjectTargetDateChange {
  id           String   @id @default(cuid())
  projectId    String
  previousDate DateTime
  newDate      DateTime
  reason       String
  approvedBy   String?
  createdById  String?
  createdAt    DateTime @default(now())
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy    User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([createdById])
}

model User {
  id                      String                    @id @default(cuid())
  email                   String                    @unique
  name                    String
  role                    UserRole                  @default(EXECUTIVE_VIEWER)
  passwordHash            String?
  isActive                Boolean                   @default(true)
  lastLoginAt             DateTime?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  sessions                UserSession[]
  wbsCommands             WbsCommand[]
  wbsBaselines            WbsBaseline[]
  auditEvents             AuditEvent[]
  auditEventChanges       AuditEventChange[]
  wbsTombstonesDeleted    WbsTombstone[]            @relation("WbsTombstoneDeletedBy")
  wbsTombstonesRestored   WbsTombstone[]            @relation("WbsTombstoneRestoredBy")
  savedViews              SavedView[]
  apiTokensCreated        ApiToken[]                @relation("ApiTokenCreatedBy")
  webhookEndpointsCreated WebhookEndpoint[]         @relation("WebhookEndpointCreatedBy")
  targetDateChanges       ProjectTargetDateChange[]
  projectAccesses         ProjectAccess[]
  businessUnitMemberships BusinessUnitMembership[]
  leaveEmployees          LeaveEmployee[]
  pageVisits              PageVisit[]

  @@index([role, isActive])
}

model PageVisit {
  id                   String             @id @default(cuid())
  eventId              String             @unique
  actorType            PageVisitActorType
  userId               String?
  userName             String?
  anonymousVisitorHash String?
  projectId            String?
  projectCode          String?
  projectName          String?
  pageKey              String
  occurredAt           DateTime           @default(now())
  user                 User?              @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([occurredAt])
  @@index([userId])
}

model ProjectAccess {
  id          String             @id @default(cuid())
  projectId   String
  userId      String
  level       ProjectAccessLevel
  grantedById String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  project     Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId, level])
  @@index([projectId, level])
}

model RolePermission {
  id         String   @id @default(cuid())
  role       UserRole
  permission String
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([role, permission])
  @@index([role])
  @@index([permission])
}

model DictionaryItem {
  id          String   @id @default(cuid())
  dictionary  String
  code        String
  label       String
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([dictionary, code])
  @@index([dictionary, isActive, sortOrder])
}

model SystemSetting {
  key       String   @id
  value     String   @default("")
  isSecret  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  userAgent String?
  ipAddress String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model SavedView {
  id         String    @id @default(cuid())
  ownerId    String?
  projectId  String?
  viewType   String
  name       String
  config     Json
  isShared   Boolean   @default(false)
  sortOrder  Int       @default(0)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  owner      User?     @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  project    Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([ownerId, viewType])
  @@index([projectId, viewType])
  @@index([isShared, viewType])
  @@index([updatedAt])
}

model ApiToken {
  id                 String    @id @default(cuid())
  name               String
  tokenHash          String    @unique
  tokenPrefix        String
  scopes             Json
  isActive           Boolean   @default(true)
  rateLimitPerMinute Int       @default(120)
  expiresAt          DateTime?
  lastUsedAt         DateTime?
  createdById        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  createdBy          User?     @relation("ApiTokenCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([createdById])
  @@index([isActive, expiresAt])
  @@index([tokenPrefix])
}

model WebhookEndpoint {
  id          String            @id @default(cuid())
  name        String
  url         String
  secret      String?
  events      Json
  isActive    Boolean           @default(true)
  createdById String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  createdBy   User?             @relation("WebhookEndpointCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  deliveries  WebhookDelivery[]

  @@index([createdById])
  @@index([isActive])
}

model WebhookDelivery {
  id           String          @id @default(cuid())
  endpointId   String
  eventType    String
  payload      Json
  status       String          @default("PENDING")
  statusCode   Int?
  responseBody String?
  error        String?
  attemptedAt  DateTime?
  createdAt    DateTime        @default(now())
  endpoint     WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([endpointId, createdAt])
  @@index([eventType, createdAt])
  @@index([status, createdAt])
}

model Milestone {
  id          String   @id @default(cuid())
  projectId   String
  code        String?
  title       String
  dueDate     DateTime
  status      String   @default("Planned")
  owner       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, dueDate])
  @@index([projectId, code])
}

model JiraIntegration {
  id            String    @id @default(cuid())
  projectId     String    @unique
  baseUrl       String
  boardUrl      String
  projectKey    String
  issuesJql     String
  openIssuesJql String
  syncStatus    String    @default("NOT_CONFIGURED")
  lastSyncedAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model JiraAnalyticsSettings {
  id                            String                 @id @default(cuid())
  projectId                     String                 @unique
  jiraScopeType                 JiraAnalyticsScopeType @default(LABEL)
  jiraScopeValue                String
  jiraLabel                     String                 @default("")
  dashboardConfig               Json?
  semanticDefaultWidgetsVersion Int                    @default(0)
  syncStatus                    String                 @default("NOT_CONFIGURED")
  lastSyncedAt                  DateTime?
  currentProjectionRefreshedAt  DateTime?
  syncStartedAt                 DateTime?
  syncLockExpiresAt             DateTime?
  syncRunId                     String?
  syncFenceToken                Int?
  historyCursorUpdatedAt        DateTime?
  historyCursorJiraIssueId      String?
  historyLastFullReconciledAt   DateTime?
  historyFullCursorIssueKey     String?
  historyFullStartedAt          DateTime?
  createdAt                     DateTime               @default(now())
  updatedAt                     DateTime               @updatedAt
  project                       Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model JiraSyncRun {
  id                         String                 @id @default(cuid())
  projectId                  String
  kind                       JiraSyncRunKind        @default(SYNC)
  status                     JiraSyncRunStatus      @default(QUEUED)
  phase                      String                 @default("PENDING")
  activeSlot                 String?
  historyWriteEnabled        Boolean
  jiraScopeType              JiraAnalyticsScopeType
  jiraScopeValue             String
  jiraBaseUrl                String?
  scopeChanged               Boolean                @default(false)
  requestedById              String?
  requestedByRole            String?
  attempt                    Int                    @default(0)
  deadlinePauseCount         Int                    @default(0)
  maxAttempts                Int                    @default(3)
  fenceToken                 Int                    @default(0)
  workerId                   String?
  leaseExpiresAt             DateTime?
  heartbeatAt                DateTime?
  deadlineAt                 DateTime?
  enqueuedAt                 DateTime               @default(now())
  startedAt                  DateTime?
  finishedAt                 DateTime?
  elapsedMs                  Int?
  resumeCursorIssueKey       String?
  resumedFromRunId           String?
  discoveredIssueCount       Int                    @default(0)
  hydratedIssueCount         Int                    @default(0)
  versionsCreated            Int                    @default(0)
  retriesQueued              Int                    @default(0)
  jiraRequestCount           Int                    @default(0)
  jiraRequestDurationMsTotal Int                    @default(0)
  jiraRequestDurationMsMax   Int                    @default(0)
  jiraRequestsByRoute        Json?                  @db.JsonB
  jiraRequestsByStatusClass  Json?                  @db.JsonB
  progressDone               Int                    @default(0)
  progressTotal              Int                    @default(0)
  progressUnit               String?
  result                     Json?                  @db.JsonB
  errorCode                  String?
  errorMessage               String?
  createdAt                  DateTime               @default(now())
  updatedAt                  DateTime               @updatedAt
  project                    Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, activeSlot])
  @@index([activeSlot, status, enqueuedAt])
  @@index([projectId, enqueuedAt(sort: Desc)])
  @@index([projectId, kind, status])
}

model JiraAggregateDefinition {
  id                      String                            @id @default(cuid())
  projectId               String
  aggregateKey            String                            @default("")
  system                  Boolean                           @default(false)
  name                    String
  nameKey                 String
  description             String                            @default("")
  source                  String
  definitionSchemaVersion Int                               @default(1)
  exposedFields           Json?                             @db.JsonB
  baseFilterLogic         String?
  baseFilters             Json?                             @db.JsonB
  rowConfig               Json?                             @db.JsonB
  metric                  String
  groupBy                 String
  scope                   String
  filterLogic             String
  filters                 Json                              @db.JsonB
  periodMode              String
  periodDays              Int?
  timeZone                String                            @default("Europe/Moscow")
  fingerprint             String                            @db.Char(64)
  sortOrder               Int                               @default(0)
  version                 Int                               @default(1)
  publishedVersion        Int?
  draftDefinition         Json?                             @db.JsonB
  archivedAt              DateTime?
  createdAt               DateTime                          @default(now())
  updatedAt               DateTime                          @updatedAt
  project                 Project                           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  revisions               JiraAggregateDefinitionRevision[]

  @@unique([projectId, nameKey])
  @@unique([projectId, aggregateKey])
  @@index([projectId, fingerprint])
  @@index([projectId, sortOrder, createdAt])
}

model JiraAggregateDefinitionRevision {
  id          String                  @id @default(cuid())
  projectId   String
  aggregateId String
  version     Int
  definition  Json                    @db.JsonB
  fingerprint String                  @db.Char(64)
  status      String                  @default("draft")
  changeKind  String                  @default("compatible")
  publishedAt DateTime?
  createdAt   DateTime                @default(now())
  project     Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  aggregate   JiraAggregateDefinition @relation(fields: [aggregateId], references: [id], onDelete: Cascade)

  @@unique([aggregateId, version])
  @@index([projectId, aggregateId, version])
}

model GitlabBranchSyncRun {
  id                  String               @id @default(cuid())
  projectId           String
  aggregateId         String
  aggregateVersion    Int
  scopeKey            String               @db.Char(64)
  projectPath         String
  targetBranch        String
  headSha             String?
  lookbackDays        Int
  includeMergeCommits Boolean
  windowStartedAt     DateTime
  windowEndedAt       DateTime
  status              String
  commitCount         Int                  @default(0)
  linkedCount         Int                  @default(0)
  unlinkedCount       Int                  @default(0)
  undeterminedCount   Int                  @default(0)
  errorMessage        String?
  startedAt           DateTime             @default(now())
  finishedAt          DateTime?
  createdById         String?
  project             Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  commits             GitlabBranchCommit[]

  @@index([projectId, aggregateId, startedAt])
  @@index([projectId, scopeKey, startedAt])
}

model GitlabBranchCommit {
  id                String               @id @default(cuid())
  projectId         String
  syncRunId         String?
  scopeKey          String               @db.Char(64)
  projectPath       String
  targetBranch      String
  commitSha         String
  shortSha          String
  title             String
  message           String
  authorName        String
  authorEmail       String?
  committedAt       DateTime
  webUrl            String
  sourceBranch      String?
  mergeRequestIid   Int?
  mergeRequestTitle String?
  mergeRequestUrl   String?
  jiraKeys          String[]             @default([])
  jiraLinkState     String
  observedAt        DateTime
  retiredAt         DateTime?
  project           Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  syncRun           GitlabBranchSyncRun? @relation(fields: [syncRunId], references: [id], onDelete: SetNull)

  @@unique([projectId, scopeKey, commitSha])
  @@index([projectId, scopeKey, committedAt])
  @@index([projectId, jiraLinkState, committedAt])
  @@index([syncRunId])
}

model JiraAnalyticsDashboardConversion {
  id                   String                     @id @default(cuid())
  projectId            String                     @unique
  originalConfig       Json                       @db.JsonB
  originalConfigStored Boolean                    @default(true)
  sourceConfigHash     String                     @db.Char(64)
  originalConfigHash   String                     @db.Char(64)
  convertedConfigHash  String                     @db.Char(64)
  createdDefinitionIds Json                       @default("[]") @db.JsonB
  attempt              Int                        @default(1)
  rollbackState        JiraAnalyticsRollbackState @default(AVAILABLE)
  convertedAt          DateTime                   @default(now())
  rolledBackAt         DateTime?
  rollbackFinalizedAt  DateTime?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  project              Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([convertedAt])
  @@index([rolledBackAt])
  @@index([rollbackState])
}

model Task {
  id            String    @id @default(cuid())
  projectId     String
  title         String
  owner         String
  status        String
  priority      String
  dueDate       DateTime?
  jiraTicketKey String?
  jiraTicketUrl String?
  jiraStatus    String?
  jiraAssignee  String?
  jiraPriority  String?
  jiraUpdatedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model WbsItem {
  id                String              @id @default(cuid())
  projectId         String
  parentId          String?
  code              String
  title             String
  type              WbsItemType         @default(TASK)
  status            WbsItemStatus       @default(NOT_STARTED)
  owner             String
  startDate         DateTime?
  dueDate           DateTime?
  baselineStartDate DateTime?
  baselineDueDate   DateTime?
  forecastStartDate DateTime?
  forecastDueDate   DateTime?
  wbsLevel          Int?
  predecessor1      String?
  predecessor2      String?
  predecessor3      String?
  predecessor4      String?
  predecessor5      String?
  predecessor6      String?
  leadLagDays       Int                 @default(0)
  workDays          Int?
  calendarDays      Int?
  excelStartDate    DateTime?
  excelEndDate      DateTime?
  planWorkDays      Int?
  planCalendarDays  Int?
  calendarCode      ProjectCalendarCode @default(RU)
  templateColor     String?
  priority          String?
  effortPercent     Int                 @default(0)
  plannedCost       Decimal             @default(0) @db.Decimal(14, 2)
  forecastCost      Decimal             @default(0) @db.Decimal(14, 2)
  progress          Int                 @default(0)
  jiraTicketKey     String?
  jiraTicketUrl     String?
  jiraGoalLabels    String[]            @default([])
  mattermostUrl     String?
  description       String?
  comment           String?
  closedAt          DateTime?
  sortOrder         Int                 @default(0)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  project           Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent            WbsItem?            @relation("WbsHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children          WbsItem[]           @relation("WbsHierarchy")
  predecessors      WbsDependency[]     @relation("WbsDependencySuccessor")
  successors        WbsDependency[]     @relation("WbsDependencyPredecessor")
  phaseIssues       Issue[]             @relation("IssuePhase")
  workPackageIssue  Issue?              @relation("IssueWorkPackage")

  @@unique([projectId, code])
  @@index([projectId, parentId])
  @@index([projectId, sortOrder])
  @@index([projectId, closedAt])
}

model WbsCommand {
  id             String         @id @default(cuid())
  projectId      String
  userId         String?
  type           WbsCommandType
  payload        Json
  beforeSnapshot Json?
  afterSnapshot  Json?
  createdAt      DateTime       @default(now())
  project        Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user           User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([userId, createdAt])
  @@index([type, createdAt])
}

model ProjectBusinessRequirements {
  id        String   @id @default(cuid())
  projectId String   @unique
  columns   Json
  rows      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model WbsBaseline {
  id          String            @id @default(cuid())
  projectId   String
  version     Int
  title       String
  status      WbsBaselineStatus @default(ACTIVE)
  createdById String?
  createdAt   DateTime          @default(now())
  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy   User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  items       WbsBaselineItem[]

  @@unique([projectId, version])
  @@index([projectId, status])
  @@index([createdById])
}

model WbsBaselineItem {
  id              String              @id @default(cuid())
  baselineId      String
  sourceWbsItemId String?
  parentCode      String?
  code            String
  title           String
  type            WbsItemType         @default(TASK)
  status          WbsItemStatus       @default(NOT_STARTED)
  owner           String
  startDate       DateTime?
  dueDate         DateTime?
  wbsLevel        Int?
  predecessor1    String?
  predecessor2    String?
  predecessor3    String?
  predecessor4    String?
  predecessor5    String?
  predecessor6    String?
  leadLagDays     Int                 @default(0)
  workDays        Int?
  calendarDays    Int?
  calendarCode    ProjectCalendarCode @default(RU)
  effortPercent   Int                 @default(0)
  progress        Int                 @default(0)
  sortOrder       Int                 @default(0)
  baseline        WbsBaseline         @relation(fields: [baselineId], references: [id], onDelete: Cascade)

  @@unique([baselineId, code])
  @@index([baselineId, sortOrder])
  @@index([sourceWbsItemId])
}

model ProjectCalendarOverride {
  id           String              @id @default(cuid())
  projectId    String
  calendarCode ProjectCalendarCode
  date         DateTime
  isWorkingDay Boolean
  description  String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  project      Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, calendarCode, date])
  @@index([projectId, calendarCode, date])
}

model WbsDependency {
  id            String            @id @default(cuid())
  projectId     String
  predecessorId String
  successorId   String
  type          WbsDependencyType @default(FS)
  lagDays       Int               @default(0)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  project       Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  predecessor   WbsItem           @relation("WbsDependencyPredecessor", fields: [predecessorId], references: [id], onDelete: Cascade)
  successor     WbsItem           @relation("WbsDependencySuccessor", fields: [successorId], references: [id], onDelete: Cascade)

  @@unique([projectId, predecessorId, successorId, type])
  @@index([projectId, predecessorId])
  @@index([projectId, successorId])
}

model Issue {
  id               String              @id @default(cuid())
  projectId        String
  phaseId          String?
  workPackageId    String?             @unique
  riskId           String?
  source           IssueSource
  category         String              @default("Без раздела")
  title            String
  referenceLabel   String              @default("")
  referenceUrl     String?
  severity         IssueSeverity
  readiness        RagStatus           @default(RED)
  status           String
  owner            String
  impact           String
  decisionRequired Boolean             @default(false)
  dueDate          DateTime?
  initialDueDate   DateTime?
  closedDelayDays  Int?
  jiraTicketKey    String?
  jiraTicketUrl    String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  project          Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phase            WbsItem?            @relation("IssuePhase", fields: [phaseId], references: [id], onDelete: SetNull)
  workPackage      WbsItem?            @relation("IssueWorkPackage", fields: [workPackageId], references: [id], onDelete: SetNull)
  risk             RaidItem?           @relation("IssueRisk", fields: [riskId], references: [id], onDelete: SetNull)
  threadLinks      IssueThreadLink[]
  jiraLinks        IssueJiraLink[]
  statusUpdates    IssueStatusUpdate[]

  @@index([projectId, phaseId])
  @@index([riskId])
}

model IssueThreadLink {
  id        String   @id @default(cuid())
  issueId   String
  threadUrl String
  createdAt DateTime @default(now())
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@unique([issueId, threadUrl])
  @@index([issueId, createdAt])
}

model IssueJiraLink {
  id        String   @id @default(cuid())
  issueId   String
  jiraKey   String
  jiraUrl   String
  createdAt DateTime @default(now())
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@unique([issueId, jiraKey])
  @@index([jiraKey])
}

model IssueStatusUpdate {
  id        String   @id @default(cuid())
  issueId   String
  statusAt  DateTime
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([issueId, statusAt])
  @@index([issueId, createdAt])
}

model JiraIssueSnapshot {
  id                          String                      @id @default(cuid())
  projectId                   String
  jiraId                      String?
  issueKey                    String
  issueUrl                    String
  summary                     String
  status                      String
  priority                    String
  assignee                    String?
  reporter                    String?
  issueType                   String
  labels                      String[]                    @default([])
  resolution                  String?
  sprint                      String?
  issueCreatedAt              DateTime?
  criticalPriorityAt          DateTime?
  criticalEndPriority         String?
  resolutionAt                DateTime?
  criticalSlaTracked          Boolean                     @default(false)
  commitCount                 Int                         @default(0)
  mergeRequestCount           Int                         @default(0)
  developmentUpdatedAt        DateTime?
  developmentDataAvailable    Boolean                     @default(false)
  developmentBaselineCaptured Boolean                     @default(false)
  transitionHistoryComplete   Boolean                     @default(false)
  updatedAt                   DateTime
  syncedAt                    DateTime                    @default(now())
  retiredAt                   DateTime?
  currentVersionId            String?                     @unique
  projectionUnversionedSince  DateTime?
  project                     Project                     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  currentVersion              JiraIssueVersion?           @relation("JiraCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions                    JiraIssueVersion[]          @relation("JiraSnapshotVersions")
  workSections                JiraWorkSectionIssue[]
  statusTransitions           JiraIssueStatusTransition[]
  labelChanges                JiraIssueLabelChange[]
  developmentActivities       JiraDevelopmentActivity[]

  @@unique([projectId, issueKey])
  @@index([projectId, syncedAt])
  @@index([projectId, status])
  @@index([labels], type: Gin)
  @@index([projectId, criticalSlaTracked])
  @@index([projectId, retiredAt])
  @@index([projectId, projectionUnversionedSince])
}

model JiraIssueVersion {
  id                           String                     @id @default(cuid())
  projectId                    String
  snapshotId                   String
  jiraIssueId                  String
  issueKey                     String
  observedAt                   DateTime                   @default(now())
  jiraUpdatedAt                DateTime
  schemaVersion                Int                        @default(1)
  provenance                   JiraIssueVersionProvenance @default(OBSERVED)
  contentHash                  String                     @db.Char(64)
  payload                      Json                       @db.JsonB
  payloadBytes                 Int
  syncRunId                    String
  changelogComplete            Boolean
  commentsComplete             Boolean
  worklogsComplete             Boolean
  remoteLinksComplete          Boolean
  attachmentReferencesStripped Int                        @default(0)
  validationWarnings           Json?
  summary                      String
  issueUrl                     String
  issueType                    String
  status                       String
  statusCategory               String?
  priority                     String
  resolution                   String?
  resolutionAt                 DateTime?
  issueCreatedAt               DateTime?
  issueUpdatedAt               DateTime
  assignee                     String?
  reporter                     String?
  parentKey                    String?
  epicKey                      String?
  labels                       String[]                   @default([])
  sprintIds                    String[]                   @default([])
  sprint                       String?
  criticalPriorityAt           DateTime?
  criticalEndPriority          String?
  commitCount                  Int                        @default(0)
  mergeRequestCount            Int                        @default(0)
  developmentUpdatedAt         DateTime?
  developmentDataAvailable     Boolean                    @default(false)
  developmentBaselineCaptured  Boolean                    @default(false)
  transitionHistoryComplete    Boolean                    @default(false)
  createdAt                    DateTime                   @default(now())
  project                      Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  snapshot                     JiraIssueSnapshot          @relation("JiraSnapshotVersions", fields: [snapshotId], references: [id], onDelete: Cascade)
  currentForSnapshot           JiraIssueSnapshot?         @relation("JiraCurrentVersion")

  @@unique([projectId, jiraIssueId, contentHash])
  @@index([projectId, jiraUpdatedAt, jiraIssueId])
  @@index([snapshotId, observedAt])
  @@index([projectId, status, priority])
  @@index([projectId, resolution, resolutionAt])
  @@index([projectId, syncRunId])
  @@index([labels], type: Gin)
}

model JiraIssueHistoryRetry {
  id                    String                 @id @default(cuid())
  projectId             String
  jiraIssueId           String?
  issueKey              String
  reasonCode            String
  lastError             String
  attempts              Int                    @default(1)
  firstFailedAt         DateTime               @default(now())
  lastFailedAt          DateTime               @default(now())
  nextRetryAt           DateTime
  lastObservedUpdatedAt DateTime?
  status                JiraHistoryRetryStatus @default(PENDING)
  resolvedAt            DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  project               Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, issueKey])
  @@index([status, nextRetryAt])
  @@index([projectId, status, firstFailedAt])
}

model JiraIssueStatusTransition {
  id             String            @id @default(cuid())
  snapshotId     String
  transitionKey  String
  fromStatus     String?
  toStatus       String
  transitionedAt DateTime
  actor          String?
  createdAt      DateTime          @default(now())
  snapshot       JiraIssueSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@unique([snapshotId, transitionKey])
  @@index([snapshotId, transitionedAt])
  @@index([toStatus, transitionedAt])
}

model JiraIssueLabelChange {
  id         String            @id @default(cuid())
  snapshotId String
  changeKey  String
  changedAt  DateTime
  fromLabels String[]          @default([])
  toLabels   String[]          @default([])
  actor      String?
  createdAt  DateTime          @default(now())
  snapshot   JiraIssueSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@unique([snapshotId, changeKey])
  @@index([snapshotId, changedAt])
  @@index([changedAt])
  @@index([fromLabels], type: Gin)
  @@index([toLabels], type: Gin)
}

model JiraDevelopmentActivity {
  id                  String            @id @default(cuid())
  snapshotId          String
  activityKey         String
  activityAt          DateTime
  commitCount         Int               @default(0)
  mergeRequestCount   Int               @default(0)
  sprintAtObservation String?
  isBaseline          Boolean           @default(false)
  observedAt          DateTime          @default(now())
  snapshot            JiraIssueSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@unique([snapshotId, activityKey])
  @@index([snapshotId, activityAt])
  @@index([activityAt])
}

model JiraWorkSection {
  id        String                 @id @default(cuid())
  projectId String
  sortOrder Int
  title     String
  jql       String                 @default("")
  filterUrl String                 @default("")
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
  project   Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues    JiraWorkSectionIssue[]

  @@unique([projectId, sortOrder])
  @@index([projectId])
}

model JiraWorkSectionIssue {
  sectionId  String
  snapshotId String
  syncedAt   DateTime          @default(now())
  section    JiraWorkSection   @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  snapshot   JiraIssueSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@id([sectionId, snapshotId])
  @@index([snapshotId])
}

model ExecutiveOverview {
  id                String         @id @default(cuid())
  projectId         String
  version           Int
  status            OverviewStatus @default(DRAFT)
  generatedAt       DateTime?
  reviewRequestedAt DateTime?
  approvedAt        DateTime?
  approvedBy        String?
  publishedAt       DateTime?
  executiveSummary  String
  kpis              Json?
  qualityGates      Json?
  risks             Json?
  nextSteps         Json?
  decisions         Json
  evidence          Json
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  project           Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, version])
}

model ProjectArtifact {
  id          String   @id @default(cuid())
  projectId   String
  title       String
  type        String
  owner       String
  status      String   @default("Draft")
  url         String?
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, sortOrder])
}

model RaidItem {
  id                 String                 @id @default(cuid())
  projectId          String
  type               RaidItemType
  title              String
  description        String
  owner              String
  status             RaidItemStatus         @default(OPEN)
  probability        Int                    @default(0)
  impact             Int                    @default(0)
  riskScore          Int                    @default(0)
  mitigationPlan     String?
  contingencyPlan    String?
  dueDate            DateTime?
  residualRisk       Int                    @default(0)
  validationDate     DateTime?
  linkedRiskId       String?
  dependencyType     String?
  predecessor        String?
  successor          String?
  supplier           String?
  jiraTicketKey      String?
  jiraTicketUrl      String?
  decisionRequired   Boolean                @default(false)
  escalationLevel    String                 @default("Project")
  scheduleImpactDays Int                    @default(0)
  budgetImpact       Decimal                @default(0) @db.Decimal(14, 2)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  project            Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  linkedRisk         RaidItem?              @relation("RaidLinkedRisk", fields: [linkedRiskId], references: [id], onDelete: SetNull)
  linkedAssumptions  RaidItem[]             @relation("RaidLinkedRisk")
  openIssues         Issue[]                @relation("IssueRisk")
  statusUpdates      RaidItemStatusUpdate[]

  @@index([projectId, type, status])
  @@index([projectId, riskScore])
  @@index([linkedRiskId])
}

model RaidItemStatusUpdate {
  id         String   @id @default(cuid())
  raidItemId String
  statusAt   DateTime
  text       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  raidItem   RaidItem @relation(fields: [raidItemId], references: [id], onDelete: Cascade)

  @@index([raidItemId, statusAt])
  @@index([raidItemId, createdAt])
}

model ChangeRequest {
  id                 String              @id @default(cuid())
  projectId          String
  type               ChangeRequestType
  title              String
  description        String
  owner              String
  status             ChangeRequestStatus @default(DRAFT)
  impactAnalysis     String
  affectedBaseline   String
  implementationPlan String?
  scheduleImpactDays Int                 @default(0)
  budgetImpact       Decimal             @default(0) @db.Decimal(14, 2)
  scopeImpact        String?
  approvalRoute      String              @default("PMO -> Sponsor")
  decisionRequired   Boolean             @default(false)
  dueDate            DateTime?
  approvedAt         DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  project            Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
  @@index([projectId, updatedAt])
}

model AuditEvent {
  id           String             @id @default(cuid())
  actorId      String?
  actorEmail   String?
  actorName    String?
  action       String
  objectType   String
  objectId     String?
  projectId    String?
  ipAddress    String?
  userAgent    String?
  beforeValue  Json?
  afterValue   Json?
  metadata     Json?
  createdAt    DateTime           @default(now())
  actor        User?              @relation(fields: [actorId], references: [id], onDelete: SetNull)
  changes      AuditEventChange[]
  wbsTombstone WbsTombstone?

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([objectType, objectId])
  @@index([projectId, createdAt])
  @@index([action, createdAt])
}

model AuditEventChange {
  id           String     @id @default(cuid())
  auditEventId String
  actorId      String?
  projectId    String?
  objectType   String
  objectId     String?
  field        String
  oldValue     Json?
  newValue     Json?
  oldText      String?
  newText      String?
  createdAt    DateTime   @default(now())
  auditEvent   AuditEvent @relation(fields: [auditEventId], references: [id], onDelete: Cascade)
  actor        User?      @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([auditEventId])
  @@index([projectId, createdAt])
  @@index([objectType, objectId, createdAt])
  @@index([field, createdAt])
  @@index([actorId, createdAt])
}

model WbsTombstone {
  id             String      @id @default(cuid())
  projectId      String
  auditEventId   String?     @unique
  deletedById    String?
  restoredById   String?
  itemIds        Json
  itemCount      Int
  items          Json
  dependencies   Json?
  expiresAt      DateTime
  restoredAt     DateTime?
  restoredRootId String?
  createdAt      DateTime    @default(now())
  project        Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  auditEvent     AuditEvent? @relation(fields: [auditEventId], references: [id], onDelete: SetNull)
  deletedBy      User?       @relation("WbsTombstoneDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  restoredBy     User?       @relation("WbsTombstoneRestoredBy", fields: [restoredById], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([expiresAt])
  @@index([restoredAt])
  @@index([deletedById, createdAt])
  @@index([restoredById, restoredAt])
}

model ProjectArtifactTable {
  id        String   @id @default(cuid())
  projectId String   @unique
  columns   Json
  rows      Json
  revision  Int      @default(1)
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectArtifactFile {
  id        String   @id @default(cuid())
  projectId String
  name      String
  data      Bytes
  size      Int
  createdAt DateTime @default(now())
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

/// A person on the leave schedule. Not every person is a user of the system.
model LeaveEmployee {
  id         String   @id @default(cuid())
  name       String
  department String   @default("")
  userId     String?  @unique
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  leaves     Leave[]
}

model LeaveType {
  id        String   @id @default(cuid())
  name      String
  nameEn    String   @default("")
  color     String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  leaves    Leave[]
}

model Leave {
  id          String        @id @default(cuid())
  employeeId  String
  typeId      String
  startDate   DateTime      @db.Date
  endDate     DateTime      @db.Date
  comment     String        @default("")
  createdById String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  employee    LeaveEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type        LeaveType     @relation(fields: [typeId], references: [id], onDelete: Restrict)

  @@index([employeeId, startDate])
  @@index([startDate, endDate])
}

/// Deviations from the Monday-to-Friday week: public holidays and working weekends.
model LeaveCalendarDay {
  date         DateTime @id @db.Date
  isWorkingDay Boolean
  description  String   @default("")
  updatedAt    DateTime @default(now()) @updatedAt
}
