generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RagStatus {
  GREEN
  AMBER
  RED
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  ON_HOLD
  CLOSED
}

enum IssueSource {
  INTERNAL
  JIRA
}

enum IssueSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum OverviewStatus {
  DRAFT
  GENERATED
  PM_REVIEW
  APPROVED
  PUBLISHED
}

enum WbsItemType {
  PHASE
  WORK_PACKAGE
  DELIVERABLE
  MILESTONE
  GOAL
  TASK
}

enum WbsItemStatus {
  NOT_STARTED
  IN_PROGRESS
  IN_REVIEW
  AT_RISK
  BLOCKED
  DONE
  CANCELLED
}

enum RaidItemType {
  RISK
  ASSUMPTION
  DEPENDENCY
}

enum RaidItemStatus {
  OPEN
  IN_PROGRESS
  MITIGATED
  VALIDATED
  BREACHED
  CLOSED
}

enum ChangeRequestType {
  SCOPE
  BUDGET
  SCHEDULE
  RESOURCE
}

enum ChangeRequestStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  APPROVED
  REJECTED
  IMPLEMENTED
}

enum WbsDependencyType {
  FS
  SS
  FF
  SF
}

enum ProjectCalendarCode {
  RU
  CN
  RU_CN
}

enum UserRole {
  ADMIN
  PROJECT_MANAGER
  TEAM_MEMBER
  EXECUTIVE_VIEWER
}

enum WbsCommandType {
  CREATE
  UPDATE
  DELETE
  MOVE
  INDENT
  OUTDENT
  BULK_UPDATE
  RESTORE
  BASELINE
}

enum WbsBaselineStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ProjectAccessLevel {
  VIEW
  EDIT
  ADMIN
}

enum BusinessUnitRole {
  ADMIN
  PROJECT_MANAGER
  VIEWER
}

model BusinessUnit {
  id          String                   @id @default(cuid())
  code        String                   @unique
  name        String
  isDefault   Boolean                  @default(false)
  isActive    Boolean                  @default(true)
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  projects    Project[]
  memberships BusinessUnitMembership[]

  @@index([isActive, name])
}

model BusinessUnitMembership {
  id             String           @id @default(cuid())
  businessUnitId String
  userId         String
  role           BusinessUnitRole @default(VIEWER)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  businessUnit   BusinessUnit     @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessUnitId, userId])
  @@index([userId, role])
  @@index([businessUnitId, role])
}

model BusinessUnitRolePermission {
  id         String           @id @default(cuid())
  role       BusinessUnitRole
  permission String
  enabled    Boolean          @default(true)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([role, permission])
  @@index([role])
  @@index([permission])
}

model Project {
  id               String              @id @default(cuid())
  businessUnitId   String
  parentId         String?
  code             String              @unique
  name             String
  portfolio        String
  sponsor          String
  projectManager   String
  status           ProjectStatus       @default(ACTIVE)
  rag              RagStatus           @default(GREEN)
  startDate        DateTime
  initialTargetDate DateTime?
  targetDate       DateTime
  budgetPlanned    Decimal             @db.Decimal(14, 2)
  budgetForecast   Decimal             @db.Decimal(14, 2)
  scheduleVariance Int                 @default(0)
  progress         Int                 @default(0)
  summary          String
  sortOrder        Int                 @default(0)
  uiState          Json?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  parent           Project?            @relation("ProjectHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children         Project[]           @relation("ProjectHierarchy")
  businessUnit     BusinessUnit        @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  jiraIntegration  JiraIntegration?
  jiraWorkSections JiraWorkSection[]
  tasks            Task[]
  issues           Issue[]
  jiraSnapshots    JiraIssueSnapshot[]
  overviews        ExecutiveOverview[]
  milestones       Milestone[]
  wbsItems         WbsItem[]
  wbsDependencies  WbsDependency[]
  calendarOverrides ProjectCalendarOverride[]
  artifacts        ProjectArtifact[]
  raidItems        RaidItem[]
  changeRequests   ChangeRequest[]
  targetDateChanges ProjectTargetDateChange[]
  wbsCommands      WbsCommand[]
  wbsBaselines     WbsBaseline[]
  wbsTombstones    WbsTombstone[]
  savedViews       SavedView[]
  projectAccesses  ProjectAccess[]
  businessRequirements ProjectBusinessRequirements?

  @@index([parentId])
  @@index([businessUnitId, status])
  @@index([sortOrder])
}

model ProjectTargetDateChange {
  id           String   @id @default(cuid())
  projectId    String
  previousDate DateTime
  newDate      DateTime
  reason       String
  approvedBy   String?
  createdById  String?
  createdAt    DateTime @default(now())
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy    User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([createdById])
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String
  role         UserRole      @default(EXECUTIVE_VIEWER)
  passwordHash String?
  isActive     Boolean       @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  sessions      UserSession[]
  wbsCommands  WbsCommand[]
  wbsBaselines WbsBaseline[]
  auditEvents  AuditEvent[]
  auditEventChanges AuditEventChange[]
  wbsTombstonesDeleted WbsTombstone[] @relation("WbsTombstoneDeletedBy")
  wbsTombstonesRestored WbsTombstone[] @relation("WbsTombstoneRestoredBy")
  savedViews   SavedView[]
  apiTokensCreated ApiToken[] @relation("ApiTokenCreatedBy")
  webhookEndpointsCreated WebhookEndpoint[] @relation("WebhookEndpointCreatedBy")
  targetDateChanges ProjectTargetDateChange[]
  projectAccesses ProjectAccess[]
  businessUnitMemberships BusinessUnitMembership[]

  @@index([role, isActive])
}

model ProjectAccess {
  id          String             @id @default(cuid())
  projectId   String
  userId      String
  level       ProjectAccessLevel
  grantedById String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  project     Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId, level])
  @@index([projectId, level])
}

model RolePermission {
  id         String   @id @default(cuid())
  role       UserRole
  permission String
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([role, permission])
  @@index([role])
  @@index([permission])
}

model DictionaryItem {
  id          String   @id @default(cuid())
  dictionary  String
  code        String
  label       String
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([dictionary, code])
  @@index([dictionary, isActive, sortOrder])
}

model SystemSetting {
  key       String   @id
  value     String   @default("")
  isSecret  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserSession {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  expiresAt  DateTime
  userAgent  String?
  ipAddress  String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model SavedView {
  id         String   @id @default(cuid())
  ownerId    String?
  projectId  String?
  viewType   String
  name       String
  config     Json
  isShared   Boolean  @default(false)
  sortOrder  Int      @default(0)
  lastUsedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  owner      User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  project    Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([ownerId, viewType])
  @@index([projectId, viewType])
  @@index([isShared, viewType])
  @@index([updatedAt])
}

model ApiToken {
  id                 String    @id @default(cuid())
  name               String
  tokenHash          String    @unique
  tokenPrefix        String
  scopes             Json
  isActive           Boolean   @default(true)
  rateLimitPerMinute Int       @default(120)
  expiresAt          DateTime?
  lastUsedAt         DateTime?
  createdById        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  createdBy          User?     @relation("ApiTokenCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([createdById])
  @@index([isActive, expiresAt])
  @@index([tokenPrefix])
}

model WebhookEndpoint {
  id          String            @id @default(cuid())
  name        String
  url         String
  secret      String?
  events      Json
  isActive    Boolean           @default(true)
  createdById String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  createdBy   User?             @relation("WebhookEndpointCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  deliveries  WebhookDelivery[]

  @@index([createdById])
  @@index([isActive])
}

model WebhookDelivery {
  id          String          @id @default(cuid())
  endpointId  String
  eventType   String
  payload     Json
  status      String          @default("PENDING")
  statusCode  Int?
  responseBody String?
  error       String?
  attemptedAt DateTime?
  createdAt   DateTime        @default(now())
  endpoint    WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([endpointId, createdAt])
  @@index([eventType, createdAt])
  @@index([status, createdAt])
}

model Milestone {
  id          String   @id @default(cuid())
  projectId   String
  code        String?
  title       String
  dueDate     DateTime
  status      String   @default("Planned")
  owner       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, dueDate])
  @@index([projectId, code])
}

model JiraIntegration {
  id            String    @id @default(cuid())
  projectId     String    @unique
  baseUrl       String
  boardUrl      String
  projectKey    String
  issuesJql     String
  openIssuesJql String
  syncStatus    String    @default("NOT_CONFIGURED")
  lastSyncedAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Task {
  id            String    @id @default(cuid())
  projectId     String
  title         String
  owner         String
  status        String
  priority      String
  dueDate       DateTime?
  jiraTicketKey String?
  jiraTicketUrl String?
  jiraStatus    String?
  jiraAssignee  String?
  jiraPriority  String?
  jiraUpdatedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model WbsItem {
  id            String        @id @default(cuid())
  projectId     String
  parentId      String?
  code          String
  title         String
  type          WbsItemType   @default(TASK)
  status        WbsItemStatus @default(NOT_STARTED)
  owner         String
  startDate     DateTime?
  dueDate       DateTime?
  baselineStartDate DateTime?
  baselineDueDate   DateTime?
  forecastStartDate DateTime?
  forecastDueDate   DateTime?
  wbsLevel      Int?
  predecessor1  String?
  predecessor2  String?
  predecessor3  String?
  predecessor4  String?
  predecessor5  String?
  predecessor6  String?
  leadLagDays   Int           @default(0)
  workDays      Int?
  calendarDays  Int?
  excelStartDate DateTime?
  excelEndDate   DateTime?
  planWorkDays     Int?
  planCalendarDays Int?
  calendarCode  ProjectCalendarCode @default(RU)
  templateColor String?
  priority      String?
  effortPercent Int           @default(0)
  plannedCost   Decimal       @default(0) @db.Decimal(14, 2)
  forecastCost  Decimal       @default(0) @db.Decimal(14, 2)
  progress      Int           @default(0)
  jiraTicketKey String?
  jiraTicketUrl String?
  mattermostUrl String?
  description   String?
  comment       String?
  closedAt      DateTime?
  sortOrder     Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  project       Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent        WbsItem?      @relation("WbsHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children      WbsItem[]     @relation("WbsHierarchy")
  predecessors  WbsDependency[] @relation("WbsDependencySuccessor")
  successors    WbsDependency[] @relation("WbsDependencyPredecessor")

  @@unique([projectId, code])
  @@index([projectId, parentId])
  @@index([projectId, sortOrder])
  @@index([projectId, closedAt])
}

model WbsCommand {
  id             String         @id @default(cuid())
  projectId      String
  userId         String?
  type           WbsCommandType
  payload        Json
  beforeSnapshot Json?
  afterSnapshot  Json?
  createdAt      DateTime       @default(now())
  project        Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user           User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([userId, createdAt])
  @@index([type, createdAt])
}

model ProjectBusinessRequirements {
  id        String   @id @default(cuid())
  projectId String  @unique
  columns   Json
  rows      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model WbsBaseline {
  id          String            @id @default(cuid())
  projectId   String
  version     Int
  title       String
  status      WbsBaselineStatus @default(ACTIVE)
  createdById String?
  createdAt   DateTime          @default(now())
  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy   User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  items       WbsBaselineItem[]

  @@unique([projectId, version])
  @@index([projectId, status])
  @@index([createdById])
}

model WbsBaselineItem {
  id              String              @id @default(cuid())
  baselineId      String
  sourceWbsItemId String?
  parentCode      String?
  code            String
  title           String
  type            WbsItemType         @default(TASK)
  status          WbsItemStatus       @default(NOT_STARTED)
  owner           String
  startDate       DateTime?
  dueDate         DateTime?
  wbsLevel        Int?
  predecessor1    String?
  predecessor2    String?
  predecessor3    String?
  predecessor4    String?
  predecessor5    String?
  predecessor6    String?
  leadLagDays     Int                 @default(0)
  workDays        Int?
  calendarDays    Int?
  calendarCode    ProjectCalendarCode @default(RU)
  effortPercent   Int                 @default(0)
  progress        Int                 @default(0)
  sortOrder       Int                 @default(0)
  baseline        WbsBaseline         @relation(fields: [baselineId], references: [id], onDelete: Cascade)

  @@unique([baselineId, code])
  @@index([baselineId, sortOrder])
  @@index([sourceWbsItemId])
}

model ProjectCalendarOverride {
  id          String              @id @default(cuid())
  projectId   String
  calendarCode ProjectCalendarCode
  date        DateTime
  isWorkingDay Boolean
  description String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  project     Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, calendarCode, date])
  @@index([projectId, calendarCode, date])
}

model WbsDependency {
  id            String            @id @default(cuid())
  projectId     String
  predecessorId String
  successorId   String
  type          WbsDependencyType @default(FS)
  lagDays       Int               @default(0)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  project       Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  predecessor   WbsItem           @relation("WbsDependencyPredecessor", fields: [predecessorId], references: [id], onDelete: Cascade)
  successor     WbsItem           @relation("WbsDependencySuccessor", fields: [successorId], references: [id], onDelete: Cascade)

  @@unique([projectId, predecessorId, successorId, type])
  @@index([projectId, predecessorId])
  @@index([projectId, successorId])
}

model Issue {
  id               String          @id @default(cuid())
  projectId        String
  source           IssueSource
  title            String
  severity         IssueSeverity
  status           String
  owner            String
  impact           String
  decisionRequired Boolean         @default(false)
  dueDate          DateTime?
  initialDueDate   DateTime?
  closedDelayDays  Int?
  jiraTicketKey    String?
  jiraTicketUrl    String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  project          Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  jiraLinks        IssueJiraLink[]
  statusUpdates    IssueStatusUpdate[]
}

model IssueJiraLink {
  id        String   @id @default(cuid())
  issueId   String
  jiraKey   String
  jiraUrl   String
  createdAt DateTime @default(now())
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@unique([issueId, jiraKey])
  @@index([jiraKey])
}

model IssueStatusUpdate {
  id        String   @id @default(cuid())
  issueId   String
  statusAt  DateTime
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([issueId, statusAt])
  @@index([issueId, createdAt])
}

model JiraIssueSnapshot {
  id           String                 @id @default(cuid())
  projectId    String
  issueKey     String
  issueUrl     String
  summary      String
  status       String
  priority     String
  assignee     String?
  reporter     String?
  issueType    String
  resolution   String?
  sprint       String?
  updatedAt    DateTime
  syncedAt     DateTime               @default(now())
  project      Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workSections JiraWorkSectionIssue[]

  @@unique([projectId, issueKey])
}

model JiraWorkSection {
  id        String                 @id @default(cuid())
  projectId String
  sortOrder Int
  title     String
  jql       String                 @default("")
  filterUrl String                 @default("")
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
  project   Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues    JiraWorkSectionIssue[]

  @@unique([projectId, sortOrder])
  @@index([projectId])
}

model JiraWorkSectionIssue {
  sectionId  String
  snapshotId String
  syncedAt   DateTime          @default(now())
  section    JiraWorkSection   @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  snapshot   JiraIssueSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@id([sectionId, snapshotId])
  @@index([snapshotId])
}

model ExecutiveOverview {
  id               String         @id @default(cuid())
  projectId        String
  version          Int
  status           OverviewStatus @default(DRAFT)
  generatedAt      DateTime?
  reviewRequestedAt DateTime?
  approvedAt       DateTime?
  approvedBy       String?
  publishedAt      DateTime?
  executiveSummary String
  kpis             Json?
  qualityGates     Json?
  risks            Json?
  nextSteps        Json?
  decisions        Json
  evidence         Json
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  project          Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, version])
}

model ProjectArtifact {
  id          String   @id @default(cuid())
  projectId   String
  title       String
  type        String
  owner       String
  status      String   @default("Draft")
  url         String?
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, sortOrder])
}

model RaidItem {
  id                 String         @id @default(cuid())
  projectId          String
  type               RaidItemType
  title              String
  description        String
  owner              String
  status             RaidItemStatus @default(OPEN)
  probability        Int            @default(0)
  impact             Int            @default(0)
  riskScore          Int            @default(0)
  mitigationPlan     String?
  contingencyPlan    String?
  dueDate            DateTime?
  residualRisk       Int            @default(0)
  validationDate     DateTime?
  linkedRiskId       String?
  dependencyType     String?
  predecessor        String?
  successor          String?
  supplier           String?
  jiraTicketKey      String?
  jiraTicketUrl      String?
  decisionRequired   Boolean        @default(false)
  escalationLevel    String         @default("Project")
  scheduleImpactDays Int            @default(0)
  budgetImpact       Decimal        @default(0) @db.Decimal(14, 2)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  project            Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  linkedRisk         RaidItem?      @relation("RaidLinkedRisk", fields: [linkedRiskId], references: [id], onDelete: SetNull)
  linkedAssumptions  RaidItem[]     @relation("RaidLinkedRisk")
  statusUpdates      RaidItemStatusUpdate[]

  @@index([projectId, type, status])
  @@index([projectId, riskScore])
  @@index([linkedRiskId])
}

model RaidItemStatusUpdate {
  id        String   @id @default(cuid())
  raidItemId String
  statusAt  DateTime
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  raidItem  RaidItem @relation(fields: [raidItemId], references: [id], onDelete: Cascade)

  @@index([raidItemId, statusAt])
  @@index([raidItemId, createdAt])
}

model ChangeRequest {
  id                 String              @id @default(cuid())
  projectId          String
  type               ChangeRequestType
  title              String
  description        String
  owner              String
  status             ChangeRequestStatus @default(DRAFT)
  impactAnalysis     String
  affectedBaseline   String
  implementationPlan String?
  scheduleImpactDays Int                 @default(0)
  budgetImpact       Decimal             @default(0) @db.Decimal(14, 2)
  scopeImpact        String?
  approvalRoute      String              @default("PMO -> Sponsor")
  decisionRequired   Boolean             @default(false)
  dueDate            DateTime?
  approvedAt         DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  project            Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
  @@index([projectId, updatedAt])
}

model AuditEvent {
  id          String   @id @default(cuid())
  actorId     String?
  actorEmail  String?
  actorName   String?
  action      String
  objectType  String
  objectId    String?
  projectId   String?
  ipAddress   String?
  userAgent   String?
  beforeValue Json?
  afterValue  Json?
  metadata    Json?
  createdAt   DateTime @default(now())
  actor       User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  changes     AuditEventChange[]
  wbsTombstone WbsTombstone?

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([objectType, objectId])
  @@index([projectId, createdAt])
  @@index([action, createdAt])
}

model AuditEventChange {
  id           String     @id @default(cuid())
  auditEventId String
  actorId      String?
  projectId    String?
  objectType   String
  objectId     String?
  field        String
  oldValue     Json?
  newValue     Json?
  oldText      String?
  newText      String?
  createdAt    DateTime   @default(now())
  auditEvent   AuditEvent @relation(fields: [auditEventId], references: [id], onDelete: Cascade)
  actor        User?      @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([auditEventId])
  @@index([projectId, createdAt])
  @@index([objectType, objectId, createdAt])
  @@index([field, createdAt])
  @@index([actorId, createdAt])
}

model WbsTombstone {
  id             String      @id @default(cuid())
  projectId      String
  auditEventId   String?     @unique
  deletedById    String?
  restoredById   String?
  itemIds        Json
  itemCount      Int
  items          Json
  dependencies   Json?
  expiresAt      DateTime
  restoredAt     DateTime?
  restoredRootId String?
  createdAt      DateTime    @default(now())
  project        Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  auditEvent     AuditEvent? @relation(fields: [auditEventId], references: [id], onDelete: SetNull)
  deletedBy      User?       @relation("WbsTombstoneDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  restoredBy     User?       @relation("WbsTombstoneRestoredBy", fields: [restoredById], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([expiresAt])
  @@index([restoredAt])
  @@index([deletedById, createdAt])
  @@index([restoredById, restoredAt])
}
