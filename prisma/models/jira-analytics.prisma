enum JiraAnalyticsScopeType {
  LABEL
  EPIC
}

enum JiraAnalyticsRollbackState {
  AVAILABLE
  USED
  CLOSED
}

model JiraIntegration {
  id            String    @id @default(cuid())
  projectId     String    @unique
  baseUrl       String
  boardUrl      String
  projectKey    String
  issuesJql     String
  openIssuesJql String
  syncStatus    String    @default("NOT_CONFIGURED")
  lastSyncedAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model JiraAnalyticsSettings {
  id                            String                 @id @default(cuid())
  projectId                     String                 @unique
  jiraScopeType                 JiraAnalyticsScopeType @default(LABEL)
  jiraScopeValue                String
  jiraLabel                     String                 @default("")
  dashboardConfig               Json?
  /// Field id to name, as Jira's search answers named them; an administrator picks extra fields from it.
  fieldCatalog                  Json?
  /// Up to ten extra Jira fields kept with each issue.
  extraFieldIds                 String[]               @default([])
  semanticDefaultWidgetsVersion Int                    @default(0)
  syncStatus                    String                 @default("NOT_CONFIGURED")
  lastSyncedAt                  DateTime?
  currentProjectionRefreshedAt  DateTime?
  syncStartedAt                 DateTime?
  syncLockExpiresAt             DateTime?
  syncRunId                     String?
  syncFenceToken                Int?
  historyCursorUpdatedAt        DateTime?
  historyCursorJiraIssueId      String?
  historyLastFullReconciledAt   DateTime?
  historyFullCursorIssueKey     String?
  historyFullStartedAt          DateTime?
  createdAt                     DateTime               @default(now())
  updatedAt                     DateTime               @updatedAt
  project                       Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model JiraAggregateDefinition {
  id                      String                            @id @default(cuid())
  projectId               String
  aggregateKey            String                            @default("")
  system                  Boolean                           @default(false)
  name                    String
  nameKey                 String
  description             String                            @default("")
  source                  String
  definitionSchemaVersion Int                               @default(1)
  exposedFields           Json?                             @db.JsonB
  baseFilterLogic         String?
  baseFilters             Json?                             @db.JsonB
  rowConfig               Json?                             @db.JsonB
  metric                  String
  groupBy                 String
  scope                   String
  filterLogic             String
  filters                 Json                              @db.JsonB
  periodMode              String
  periodDays              Int?
  timeZone                String                            @default("Europe/Moscow")
  fingerprint             String                            @db.Char(64)
  sortOrder               Int                               @default(0)
  version                 Int                               @default(1)
  publishedVersion        Int?
  draftDefinition         Json?                             @db.JsonB
  archivedAt              DateTime?
  createdAt               DateTime                          @default(now())
  updatedAt               DateTime                          @updatedAt
  project                 Project                           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  revisions               JiraAggregateDefinitionRevision[]

  @@unique([projectId, nameKey])
  @@unique([projectId, aggregateKey])
  @@index([projectId, fingerprint])
  @@index([projectId, sortOrder, createdAt])
}

model JiraAggregateDefinitionRevision {
  id          String                  @id @default(cuid())
  projectId   String
  aggregateId String
  version     Int
  definition  Json                    @db.JsonB
  fingerprint String                  @db.Char(64)
  status      String                  @default("draft")
  changeKind  String                  @default("compatible")
  publishedAt DateTime?
  createdAt   DateTime                @default(now())
  project     Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  aggregate   JiraAggregateDefinition @relation(fields: [aggregateId], references: [id], onDelete: Cascade)

  @@unique([aggregateId, version])
  @@index([projectId, aggregateId, version])
}

model JiraAnalyticsDashboardConversion {
  id                   String                     @id @default(cuid())
  projectId            String                     @unique
  originalConfig       Json                       @db.JsonB
  originalConfigStored Boolean                    @default(true)
  sourceConfigHash     String                     @db.Char(64)
  originalConfigHash   String                     @db.Char(64)
  convertedConfigHash  String                     @db.Char(64)
  createdDefinitionIds Json                       @default("[]") @db.JsonB
  attempt              Int                        @default(1)
  rollbackState        JiraAnalyticsRollbackState @default(AVAILABLE)
  convertedAt          DateTime                   @default(now())
  rolledBackAt         DateTime?
  rollbackFinalizedAt  DateTime?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  project              Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([convertedAt])
  @@index([rolledBackAt])
  @@index([rollbackState])
}

model JiraWorkSection {
  id        String                 @id @default(cuid())
  projectId String
  sortOrder Int
  title     String
  jql       String                 @default("")
  filterUrl String                 @default("")
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
  project   Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues    JiraWorkSectionIssue[]

  @@unique([projectId, sortOrder])
  @@index([projectId])
}

model JiraWorkSectionIssue {
  sectionId  String
  snapshotId String
  syncedAt   DateTime          @default(now())
  section    JiraWorkSection   @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  snapshot   JiraIssueSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@id([sectionId, snapshotId])
  @@index([snapshotId])
}
