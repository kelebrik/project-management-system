enum JiraSyncRunKind {
  SYNC
  BACKFILL
  CURRENT
}

enum JiraSyncRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  SUCCEEDED_WITH_RETRIES
  PAUSED_DEADLINE
  STOPPED_CAPACITY
  FAILED
  CANCELLED
}

enum JiraIssueVersionProvenance {
  OBSERVED
  RECONSTRUCTED
}

enum JiraHistoryRetryStatus {
  PENDING
  RESOLVED
}

model JiraSyncRun {
  id                         String                 @id @default(cuid())
  projectId                  String
  kind                       JiraSyncRunKind        @default(SYNC)
  status                     JiraSyncRunStatus      @default(QUEUED)
  phase                      String                 @default("PENDING")
  activeSlot                 String?
  historyWriteEnabled        Boolean
  jiraScopeType              JiraAnalyticsScopeType
  jiraScopeValue             String
  jiraBaseUrl                String?
  scopeChanged               Boolean                @default(false)
  requestedById              String?
  requestedByRole            String?
  attempt                    Int                    @default(0)
  deadlinePauseCount         Int                    @default(0)
  maxAttempts                Int                    @default(3)
  fenceToken                 Int                    @default(0)
  workerId                   String?
  leaseExpiresAt             DateTime?
  heartbeatAt                DateTime?
  deadlineAt                 DateTime?
  enqueuedAt                 DateTime               @default(now())
  startedAt                  DateTime?
  finishedAt                 DateTime?
  elapsedMs                  Int?
  resumeCursorIssueKey       String?
  resumedFromRunId           String?
  discoveredIssueCount       Int                    @default(0)
  hydratedIssueCount         Int                    @default(0)
  versionsCreated            Int                    @default(0)
  retriesQueued              Int                    @default(0)
  jiraRequestCount           Int                    @default(0)
  jiraRequestDurationMsTotal Int                    @default(0)
  jiraRequestDurationMsMax   Int                    @default(0)
  jiraRequestsByRoute        Json?                  @db.JsonB
  jiraRequestsByStatusClass  Json?                  @db.JsonB
  progressDone               Int                    @default(0)
  progressTotal              Int                    @default(0)
  progressUnit               String?
  result                     Json?                  @db.JsonB
  errorCode                  String?
  errorMessage               String?
  createdAt                  DateTime               @default(now())
  updatedAt                  DateTime               @updatedAt
  project                    Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, activeSlot])
  @@index([activeSlot, status, enqueuedAt])
  @@index([projectId, enqueuedAt(sort: Desc)])
  @@index([projectId, kind, status])
}

model JiraIssueSnapshot {
  id                          String                      @id @default(cuid())
  projectId                   String
  jiraId                      String?
  issueKey                    String
  issueUrl                    String
  summary                     String
  status                      String
  priority                    String
  assignee                    String?
  reporter                    String?
  issueType                   String
  labels                      String[]                    @default([])
  /// Extra fields for analytics (status category, epic, components, versions, story points, due date, assignee login, chosen custom fields).
  attributes                  Json?
  resolution                  String?
  sprint                      String?
  issueCreatedAt              DateTime?
  criticalPriorityAt          DateTime?
  criticalEndPriority         String?
  resolutionAt                DateTime?
  criticalSlaTracked          Boolean                     @default(false)
  commitCount                 Int                         @default(0)
  mergeRequestCount           Int                         @default(0)
  developmentUpdatedAt        DateTime?
  developmentDataAvailable    Boolean                     @default(false)
  developmentBaselineCaptured Boolean                     @default(false)
  transitionHistoryComplete   Boolean                     @default(false)
  updatedAt                   DateTime
  syncedAt                    DateTime                    @default(now())
  retiredAt                   DateTime?
  currentVersionId            String?                     @unique
  projectionUnversionedSince  DateTime?
  project                     Project                     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  currentVersion              JiraIssueVersion?           @relation("JiraCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions                    JiraIssueVersion[]          @relation("JiraSnapshotVersions")
  workSections                JiraWorkSectionIssue[]
  statusTransitions           JiraIssueStatusTransition[]
  labelChanges                JiraIssueLabelChange[]
  developmentActivities       JiraDevelopmentActivity[]

  @@unique([projectId, issueKey])
  @@index([projectId, syncedAt])
  @@index([projectId, status])
  @@index([labels], type: Gin)
  @@index([projectId, criticalSlaTracked])
  @@index([projectId, retiredAt])
  @@index([projectId, projectionUnversionedSince])
}

model JiraIssueVersion {
  id                           String                     @id @default(cuid())
  projectId                    String
  snapshotId                   String
  jiraIssueId                  String
  issueKey                     String
  observedAt                   DateTime                   @default(now())
  jiraUpdatedAt                DateTime
  schemaVersion                Int                        @default(1)
  provenance                   JiraIssueVersionProvenance @default(OBSERVED)
  contentHash                  String                     @db.Char(64)
  payload                      Json                       @db.JsonB
  payloadBytes                 Int
  syncRunId                    String
  changelogComplete            Boolean
  commentsComplete             Boolean
  worklogsComplete             Boolean
  remoteLinksComplete          Boolean
  attachmentReferencesStripped Int                        @default(0)
  validationWarnings           Json?
  summary                      String
  issueUrl                     String
  issueType                    String
  status                       String
  statusCategory               String?
  priority                     String
  resolution                   String?
  resolutionAt                 DateTime?
  issueCreatedAt               DateTime?
  issueUpdatedAt               DateTime
  assignee                     String?
  reporter                     String?
  parentKey                    String?
  epicKey                      String?
  labels                       String[]                   @default([])
  /// The same extra fields as observed in this version; null in versions made before they were read.
  attributes                   Json?
  sprintIds                    String[]                   @default([])
  sprint                       String?
  criticalPriorityAt           DateTime?
  criticalEndPriority          String?
  commitCount                  Int                        @default(0)
  mergeRequestCount            Int                        @default(0)
  developmentUpdatedAt         DateTime?
  developmentDataAvailable     Boolean                    @default(false)
  developmentBaselineCaptured  Boolean                    @default(false)
  transitionHistoryComplete    Boolean                    @default(false)
  createdAt                    DateTime                   @default(now())
  project                      Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  snapshot                     JiraIssueSnapshot          @relation("JiraSnapshotVersions", fields: [snapshotId], references: [id], onDelete: Cascade)
  currentForSnapshot           JiraIssueSnapshot?         @relation("JiraCurrentVersion")

  @@unique([projectId, jiraIssueId, contentHash])
  @@index([projectId, jiraUpdatedAt, jiraIssueId])
  @@index([snapshotId, observedAt])
  @@index([projectId, status, priority])
  @@index([projectId, resolution, resolutionAt])
  @@index([projectId, syncRunId])
  @@index([labels], type: Gin)
}

model JiraIssueHistoryRetry {
  id                    String                 @id @default(cuid())
  projectId             String
  jiraIssueId           String?
  issueKey              String
  reasonCode            String
  lastError             String
  attempts              Int                    @default(1)
  firstFailedAt         DateTime               @default(now())
  lastFailedAt          DateTime               @default(now())
  nextRetryAt           DateTime
  lastObservedUpdatedAt DateTime?
  status                JiraHistoryRetryStatus @default(PENDING)
  resolvedAt            DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  project               Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, issueKey])
  @@index([status, nextRetryAt])
  @@index([projectId, status, firstFailedAt])
}

model JiraIssueStatusTransition {
  id             String            @id @default(cuid())
  snapshotId     String
  transitionKey  String
  fromStatus     String?
  toStatus       String
  transitionedAt DateTime
  actor          String?
  createdAt      DateTime          @default(now())
  snapshot       JiraIssueSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@unique([snapshotId, transitionKey])
  @@index([snapshotId, transitionedAt])
  @@index([toStatus, transitionedAt])
}

model JiraIssueLabelChange {
  id         String            @id @default(cuid())
  snapshotId String
  changeKey  String
  changedAt  DateTime
  fromLabels String[]          @default([])
  toLabels   String[]          @default([])
  actor      String?
  createdAt  DateTime          @default(now())
  snapshot   JiraIssueSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@unique([snapshotId, changeKey])
  @@index([snapshotId, changedAt])
  @@index([changedAt])
  @@index([fromLabels], type: Gin)
  @@index([toLabels], type: Gin)
}

model JiraDevelopmentActivity {
  id                  String            @id @default(cuid())
  snapshotId          String
  activityKey         String
  activityAt          DateTime
  commitCount         Int               @default(0)
  mergeRequestCount   Int               @default(0)
  sprintAtObservation String?
  isBaseline          Boolean           @default(false)
  observedAt          DateTime          @default(now())
  snapshot            JiraIssueSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@unique([snapshotId, activityKey])
  @@index([snapshotId, activityAt])
  @@index([activityAt])
}
