DATABASE_URL="postgresql://postgres:postgres@localhost:5432/project_management_system?schema=public"
NODE_ENV="development"
PORT="3000"
# Required. "cloud" enables local password sign-in and the public demo identity;
# "corporate" keeps both off and leaves Keycloak as the only way in.
DEPLOYMENT_PROFILE="corporate"
# Required in production: how many proxies sit in front of the application.
# Too low and per-address rate limiting silently stops working.
TRUST_PROXY_HOPS="0"
WEB_ORIGIN="http://localhost:5173"
PAGE_VISIT_RETENTION_DAYS=30
# ANALYTICS_HASH_SALT="replace-with-a-stable-random-secret"
PUBLIC_APP_URL="http://localhost:3000"
JIRA_BASE_URL=""
JIRA_EMAIL=""
JIRA_API_TOKEN=""
JIRA_SPRINT_FIELD_ID="customfield_10004"
JIRA_MAX_RESULTS="100"
KEYCLOAK_HOSTNAME=""
KEYCLOAK_OIDCS_DISCOVERY_ENDPOINT=""
KEYCLOAK_CLIENT_ID=""
KEYCLOAK_CLIENT_SECRET=""
METRICS_TOKEN=""
WEBHOOK_TIMEOUT_MS="5000"
WEBHOOK_MAX_ATTEMPTS="3"
WEBHOOK_RETRY_BASE_MS="500"
