{
  "name": "project-management-system",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/shared",
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @pms/api",
    "dev:web": "npm run dev --workspace @pms/web",
    "build": "npm run build --workspaces",
    "start": "npm run start --workspace @pms/api",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run build --workspace @pms/shared && npm run typecheck:workspaces",
    "typecheck:workspaces": "npm run typecheck --workspaces --if-present",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "npm run build --workspace @pms/shared && npm run test:unit --workspace @pms/api && npm run test:unit --workspace @pms/web",
    "test:unit:ci": "scripts/ci-test-unit.sh",
    "test:integration": "tsx --test \"tests/integration/**/*.test.ts\"",
    "test:integration:ci": "scripts/ci-test-integration.sh",
    "test:e2e": "playwright test",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "backup": "scripts/backup-db.sh",
    "restore": "scripts/restore-db.sh",
    "migration:dry-run": "scripts/migration-dry-run.sh",
    "restore:drill": "scripts/restore-drill.sh",
    "integrity:capture": "scripts/db-integrity-capture.sh",
    "integrity:verify": "scripts/db-integrity-verify.sh",
    "integrity:a1": "scripts/jira-history-a1-diagnostics.sh",
    "smoke:security": "scripts/security-smoke.sh",
    "smoke:performance": "scripts/performance-smoke.sh",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "render-build": "npm ci --include=dev && npm run prisma:generate && npm run build && npm run prisma:deploy && if [ \"$SEED_DEMO_DATA\" = \"true\" ]; then npm run prisma:seed; fi"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "prisma": "^6.19.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "c8": "^10.1.3",
    "dotenv": "^16.6.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "deepmerge-ts": "8.0.1",
    "esbuild": "0.28.1",
    "nanoid": "3.3.18",
    "semver": "7.8.5"
  },
  "engines": {
    "node": ">=22 <26",
    "npm": ">=10"
  }
}
